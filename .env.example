# Copy this file to .env. Do not commit the resulting .env file.

# Required only when you enable the OpenAI advisory-agent executor.
OPENAI_API_KEY=

# OpenAI model routing. Luna handles high-volume evidence triage; Terra handles
# synthesis, candidate design, policy criticism, and code-change proposals.
AUTOTUNE_AGENT_RESEARCH_MODEL=gpt-5.6-luna
AUTOTUNE_AGENT_REASONING_MODEL=gpt-5.6-terra
AUTOTUNE_AGENT_CODE_MODEL=gpt-5.6-terra

# Hard limits for advisory work per campaign attempt.
AUTOTUNE_AGENT_MAX_CALLS_PER_ATTEMPT=6
AUTOTUNE_AGENT_MAX_RESEARCH_SOURCES=12

# Remote execution credentials stay local and are read only at run time.
RUNPOD_API_KEY=
AUTOTUNE_GITHUB_REPOSITORY=ProgMastermind/AutoTune
